    <widget class="QGroupBox" name="pickerGroup">
     <property name="title"><string>NMEA Sentence Formatter</string></property>
     <layout class="QFormLayout" name="formLayout">
      <item row="0" column="0"><widget class="QLabel" name="lblSentence"><property name="text"><string>Predefined Sentence</string></property></widget></item>
