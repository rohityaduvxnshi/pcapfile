 <class>NmeaSentencePickerDialog</class>
 <widget class="QDialog" name="NmeaSentencePickerDialog">
  <property name="geometry"><rect><x>0</x><y>0</y><width>460</width><height>140</height></rect></property>
  <property name="windowTitle"><string>Select NMEA Sentence</string></property>
  <layout class="QVBoxLayout" name="mainLayout">
