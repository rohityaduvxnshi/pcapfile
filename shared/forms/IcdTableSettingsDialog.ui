 <class>IcdTableSettingsDialog</class>
 <widget class="QDialog" name="IcdTableSettingsDialog">
  <property name="geometry"><rect><x>0</x><y>0</y><width>740</width><height>640</height></rect></property>
  <property name="maximumSize"><size><width>16777215</width><height>1000</height></size></property>
  <property name="windowTitle"><string>Table Settings</string></property>
  <layout class="QVBoxLayout" name="rootLayout" stretch="1,0,0">
   <property name="spacing"><number>6</number></property>
