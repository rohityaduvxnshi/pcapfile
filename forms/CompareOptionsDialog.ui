<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>CompareOptionsDialog</class>
 <widget class="QDialog" name="CompareOptionsDialog">
  <property name="geometry"><rect><x>0</x><y>0</y><width>820</width><height>520</height></rect></property>
  <property name="windowTitle"><string>Compare Options</string></property>
  <layout class="QVBoxLayout" name="mainLayout">

   <item>
    <widget class="QLabel" name="lblIntro">
     <property name="text"><string>Tick a section to add its columns to the CSV. &quot;Byte Offset&quot; uses 1-based positions (the first byte of the payload is 1) to match the ICD. Leave &quot;Expected&quot; blank to log the observed value only (no True/False comparison). Hover any input for details.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>

   <item>
    <widget class="QGroupBox" name="grpHeader">
     <property name="title"><string>Header check</string></property>
     <property name="checkable"><bool>true</bool></property>
     <property name="checked"><bool>false</bool></property>
     <property name="toolTip"><string>Reads N bytes starting at the given byte offset and (optionally) compares against the expected value.</string></property>
     <layout class="QHBoxLayout" name="hdrRow">
      <item><widget class="QLabel" name="lblHdrOffset"><property name="text"><string>Byte Offset:</string></property></widget></item>
      <item><widget class="QSpinBox" name="spinHdrOffset"><property name="minimum"><number>1</number></property><property name="maximum"><number>1000000</number></property><property name="value"><number>1</number></property><property name="toolTip"><string>Position of the header's first byte (1-based, like the ICD).</string></property></widget></item>
      <item><widget class="QLabel" name="lblHdrLength"><property name="text"><string>Length:</string></property></widget></item>
      <item><widget class="QSpinBox" name="spinHdrLength"><property name="minimum"><number>0</number></property><property name="maximum"><number>1024</number></property><property name="toolTip"><string>Number of bytes the header occupies.</string></property></widget></item>
      <item><widget class="QLabel" name="lblHdrMode"><property name="text"><string>Mode:</string></property></widget></item>
      <item>
       <widget class="QComboBox" name="cmbHdrMode">
        <property name="toolTip"><string>HEX = e.g. AA55 for 2 bytes. ASCII = printable text, e.g. EH for 2 bytes.</string></property>
        <item><property name="text"><string>HEX</string></property></item>
        <item><property name="text"><string>ASCII</string></property></item>
       </widget>
      </item>
      <item><widget class="QLabel" name="lblHdrExpected"><property name="text"><string>Expected:</string></property></widget></item>
      <item><widget class="QLineEdit" name="txtHdrExpected"><property name="placeholderText"><string>blank = log observed only</string></property><property name="toolTip"><string>Optional. If filled, must decode to exactly &quot;Length&quot; bytes in the chosen Mode. Blank skips the True/False compare.</string></property></widget></item>
     </layout>
    </widget>
   </item>

   <item>
    <widget class="QGroupBox" name="grpTerminator">
     <property name="title"><string>Terminator check</string></property>
     <property name="checkable"><bool>true</bool></property>
     <property name="checked"><bool>false</bool></property>
     <property name="toolTip"><string>Reads N bytes starting at the given byte offset and (optionally) compares against the expected value. For an end-of-message terminator set Byte Offset = (PayloadLength - Length + 1).</string></property>
     <layout class="QHBoxLayout" name="termRow">
      <item><widget class="QLabel" name="lblTermOffset"><property name="text"><string>Byte Offset:</string></property></widget></item>
      <item><widget class="QSpinBox" name="spinTermOffset"><property name="minimum"><number>1</number></property><property name="maximum"><number>1000000</number></property><property name="value"><number>1</number></property><property name="toolTip"><string>Position of the terminator's first byte (1-based, like the ICD).</string></property></widget></item>
      <item><widget class="QLabel" name="lblTermLength"><property name="text"><string>Length:</string></property></widget></item>
      <item><widget class="QSpinBox" name="spinTermLength"><property name="minimum"><number>0</number></property><property name="maximum"><number>1024</number></property><property name="toolTip"><string>Number of bytes the terminator occupies.</string></property></widget></item>
      <item><widget class="QLabel" name="lblTermMode"><property name="text"><string>Mode:</string></property></widget></item>
      <item>
       <widget class="QComboBox" name="cmbTermMode">
        <property name="toolTip"><string>HEX = e.g. 0D0A for CR+LF. ASCII = printable text.</string></property>
        <item><property name="text"><string>HEX</string></property></item>
        <item><property name="text"><string>ASCII</string></property></item>
       </widget>
      </item>
      <item><widget class="QLabel" name="lblTermExpected"><property name="text"><string>Expected:</string></property></widget></item>
      <item><widget class="QLineEdit" name="txtTermExpected"><property name="placeholderText"><string>blank = log observed only</string></property><property name="toolTip"><string>Optional. If filled, must decode to exactly &quot;Length&quot; bytes in the chosen Mode.</string></property></widget></item>
     </layout>
    </widget>
   </item>

   <item>
    <widget class="QGroupBox" name="grpChecksum">
     <property name="title"><string>Checksum check (computed over every byte before the stored checksum; compared against the stored value)</string></property>
     <property name="checkable"><bool>true</bool></property>
     <property name="checked"><bool>false</bool></property>
     <property name="toolTip"><string>Computes XOR or SUM of bytes 1 to (Stored Byte Offset - 1), then compares against the bytes already in the payload at the stored position.</string></property>
     <layout class="QHBoxLayout" name="csumRow">
      <item><widget class="QLabel" name="lblCsumAlgo"><property name="text"><string>Algorithm:</string></property></widget></item>
      <item>
       <widget class="QComboBox" name="cmbCsumAlgo">
        <property name="toolTip"><string>XOR = fold-XOR of every byte. SUM = arithmetic sum, masked to checksum length.</string></property>
        <item><property name="text"><string>XOR</string></property></item>
        <item><property name="text"><string>SUM</string></property></item>
       </widget>
      </item>
      <item><widget class="QLabel" name="lblCsumByteOffset"><property name="text"><string>Stored Byte Offset:</string></property></widget></item>
      <item><widget class="QSpinBox" name="spinCsumOffset"><property name="minimum"><number>1</number></property><property name="maximum"><number>1000000</number></property><property name="value"><number>1</number></property><property name="toolTip"><string>Position of the stored checksum byte(s) in the payload (1-based). The compute range is bytes 1 to (this - 1).</string></property></widget></item>
      <item><widget class="QLabel" name="lblCsumLength"><property name="text"><string>Length:</string></property></widget></item>
      <item><widget class="QSpinBox" name="spinCsumLength"><property name="minimum"><number>1</number></property><property name="maximum"><number>4</number></property><property name="value"><number>1</number></property><property name="toolTip"><string>Size of the stored checksum (1-4 bytes).</string></property></widget></item>
      <item><spacer name="csumSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
     </layout>
    </widget>
   </item>

   <item>
    <widget class="QGroupBox" name="grpRefreshRate">
     <property name="title"><string>Refresh rate check (rolling 1-second window)</string></property>
     <property name="checkable"><bool>true</bool></property>
     <property name="checked"><bool>false</bool></property>
     <property name="toolTip"><string>Counts matching packets received in the last 1 second and (optionally) compares against the expected Hz.</string></property>
     <layout class="QHBoxLayout" name="rrRow">
      <item><widget class="QLabel" name="lblRRExpected"><property name="text"><string>Expected Hz:</string></property></widget></item>
      <item><widget class="QDoubleSpinBox" name="dspRRExpected"><property name="minimum"><double>0.0</double></property><property name="maximum"><double>1000000.0</double></property><property name="decimals"><number>3</number></property><property name="toolTip"><string>0 = log observed Hz only, no comparison.</string></property></widget></item>
      <item><widget class="QLabel" name="lblRRTolerance"><property name="text"><string>Tolerance +/- Hz:</string></property></widget></item>
      <item><widget class="QDoubleSpinBox" name="dspRRTolerance"><property name="minimum"><double>0.0</double></property><property name="maximum"><double>1000000.0</double></property><property name="decimals"><number>3</number></property><property name="value"><double>1.0</double></property><property name="toolTip"><string>Allowed deviation from Expected Hz in either direction.</string></property></widget></item>
      <item><spacer name="rrSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
     </layout>
    </widget>
   </item>

   <item>
    <widget class="QGroupBox" name="grpEndian">
     <property name="title"><string>Endianness check (per multi-byte numeric field)</string></property>
     <property name="checkable"><bool>true</bool></property>
     <property name="checked"><bool>false</bool></property>
     <property name="toolTip"><string>For every multi-byte numeric field in this message, the CSV gets both the BE-decoded and LE-decoded value. Selecting BIG or LITTLE also adds a True/False column versus the project's default decode (big-endian).</string></property>
     <layout class="QHBoxLayout" name="endRow">
      <item><widget class="QLabel" name="lblEndian"><property name="text"><string>Expected:</string></property></widget></item>
      <item>
       <widget class="QComboBox" name="cmbEndian">
        <property name="toolTip"><string>BIG = high-order byte first (project default). LITTLE = low-order byte first. (don't compare) suppresses the OK column but still emits the per-field BE/LE values.</string></property>
        <item><property name="text"><string>BIG</string></property></item>
        <item><property name="text"><string>LITTLE</string></property></item>
        <item><property name="text"><string>(don't compare)</string></property></item>
       </widget>
      </item>
      <item><spacer name="endSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
     </layout>
    </widget>
   </item>

   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation"><enum>Qt::Horizontal</enum></property>
     <property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Save</set></property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
