      <item row="2" column="1"><widget class="QLineEdit" name="txtOptionalHeader"><property name="placeholderText"><string>Optional. 0 to 8 hex chars to disambiguate same-length msgs, e.g. A1B2</string></property><property name="toolTip"><string>OPTIONAL. Leave blank if not needed. When two or more messages on the same port share the same payload length, fill in the leading bytes of this message in hex (no 0x prefix, no spaces) so packets can be told apart. Up to 8 hex characters (4 bytes).</string></property><property name="maxLength"><number>32</number></property></widget></item>
