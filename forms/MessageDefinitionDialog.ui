  <property name="windowTitle"><string>Message Definition</string></property>
  <property name="styleSheet"><string>QWidget{font-family:&quot;Bahnschrift&quot;,&quot;Arial Narrow&quot;,Arial;font-size:11pt;font-weight:600;color:#ccd6f6;background-color:#0a0e1a;}QDialog{background-color:#0a0e1a;}QGroupBox{background-color:#0f1626;border:1px solid #1e2d4a;border-radius:3px;margin-top:14px;padding:6px 4px;}QGroupBox::title{subcontrol-origin:margin;subcontrol-position:top left;padding:2px 8px;color:#4fc3f7;background-color:#162035;border-radius:2px;font-weight:700;}QLineEdit,QSpinBox{background-color:#0f1626;border:1px solid #1e2d4a;border-radius:3px;padding:5px 7px;color:#ccd6f6;selection-background-color:#1c3a6e;}QLineEdit:focus,QSpinBox:focus{border:1px solid #1e88e5;}QPushButton{background-color:#0f1626;border:1px solid #1e88e5;border-radius:3px;padding:5px 12px;color:#4fc3f7;font-weight:700;}QPushButton:hover{background-color:#1c3a6e;color:#ffffff;}QPushButton:pressed{background-color:#1565c0;}</string></property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QGroupBox" name="definitionGroup">
     <property name="title"><string>Length Filter</string></property>
