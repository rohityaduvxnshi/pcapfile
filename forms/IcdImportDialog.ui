<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>IcdImportDialog</class>
 <widget class="QDialog" name="IcdImportDialog">
  <property name="geometry"><rect><x>0</x><y>0</y><width>900</width><height>720</height></rect></property>
  <property name="windowTitle"><string>Import ICD (Word .docx)</string></property>
  <layout class="QVBoxLayout" name="rootLayout">
   <property name="spacing"><number>6</number></property>
   <property name="leftMargin"><number>8</number></property>
   <property name="topMargin"><number>8</number></property>
   <property name="rightMargin"><number>8</number></property>
   <property name="bottomMargin"><number>8</number></property>
   <property name="stretch"><string>0,0,0,0,1,0,0,0</string></property>
   <item>
    <widget class="QGroupBox" name="gTables">
     <property name="title"><string>1. Tables found in the document</string></property>
     <layout class="QVBoxLayout" name="lTables">
      <property name="spacing"><number>4</number></property>
      <item>
       <widget class="QLabel" name="lblTablesHint">
        <property name="text"><string>Tick the tables that contain field definitions. Click a table to use its columns for the mapping below.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <widget class="QListWidget" name="lstTables">
        <property name="maximumSize"><size><width>16777215</width><height>110</height></size></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gMap">
     <property name="title"><string>2. Column mapping (applies to all ticked tables)</string></property>
     <layout class="QGridLayout" name="lMap">
      <property name="horizontalSpacing"><number>8</number></property>
      <property name="verticalSpacing"><number>4</number></property>
      <item row="0" column="0"><widget class="QLabel" name="lblHeaderRow"><property name="text"><string>Header row index:</string></property></widget></item>
      <item row="0" column="1"><widget class="QSpinBox" name="spnHeaderRow"><property name="maximum"><number>999</number></property></widget></item>
      <item row="0" column="2"><widget class="QLabel" name="lblOffsetBase"><property name="text"><string>Offset base:</string></property></widget></item>
      <item row="0" column="3"><widget class="QComboBox" name="cmbOffsetBase"><item><property name="text"><string>0-based (offset 0 = first byte)</string></property></item><item><property name="text"><string>1-based (offset 1 = first byte)</string></property></item></widget></item>
      <item row="1" column="0" colspan="4"><widget class="QLabel" name="lblColumnsFor"><property name="text"><string>Columns: (no table selected)</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
      <item row="2" column="0"><widget class="QLabel" name="lblNameCol"><property name="text"><string>Name column *:</string></property></widget></item>
      <item row="2" column="1"><widget class="QComboBox" name="cmbColName"/></item>
      <item row="2" column="2"><widget class="QLabel" name="lblOffsetCol"><property name="text"><string>ByteOffset column *:</string></property></widget></item>
      <item row="2" column="3"><widget class="QComboBox" name="cmbColOffset"/></item>
      <item row="3" column="0"><widget class="QLabel" name="lblTypeCol"><property name="text"><string>DataType column *:</string></property></widget></item>
      <item row="3" column="1"><widget class="QComboBox" name="cmbColType"/></item>
      <item row="3" column="2"><widget class="QLabel" name="lblLengthCol"><property name="text"><string>Length column:</string></property></widget></item>
      <item row="3" column="3"><widget class="QComboBox" name="cmbColLength"/></item>
      <item row="4" column="0"><widget class="QLabel" name="lblResCol"><property name="text"><string>Resolution column:</string></property></widget></item>
      <item row="4" column="1"><widget class="QComboBox" name="cmbColResolution"/></item>
      <item row="4" column="2"><widget class="QLabel" name="lblExprCol"><property name="text"><string>Resolution expr column:</string></property></widget></item>
      <item row="4" column="3"><widget class="QComboBox" name="cmbColExpr"/></item>
      <item row="5" column="0" colspan="4"><widget class="QPushButton" name="btnAutoDetect"><property name="text"><string>Auto-detect columns from table contents</string></property><property name="toolTip"><string>Inspect the selected table's data and guess the header row, offset base and column roles - column order does not matter. Runs automatically when you click a table; click here to re-run (e.g. after changing the header row). Always review the result before importing.</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gMsg">
     <property name="title"><string>3. Message identity</string></property>
     <layout class="QGridLayout" name="lMsg">
      <property name="horizontalSpacing"><number>8</number></property>
      <property name="verticalSpacing"><number>4</number></property>
      <item row="0" column="0"><widget class="QLabel" name="lblNameSrc"><property name="text"><string>Message name from:</string></property></widget></item>
      <item row="0" column="1"><widget class="QComboBox" name="cmbNameSource"><item><property name="text"><string>Heading above each table</string></property></item><item><property name="text"><string>Custom prefix + number</string></property></item></widget></item>
      <item row="0" column="2"><widget class="QLabel" name="lblPrefix"><property name="text"><string>Custom prefix:</string></property></widget></item>
      <item row="0" column="3"><widget class="QLineEdit" name="txtNamePrefix"><property name="text"><string>Message</string></property></widget></item>
      <item row="1" column="0"><widget class="QLabel" name="lblDefaultPort"><property name="text"><string>Default port:</string></property></widget></item>
      <item row="1" column="1"><widget class="QSpinBox" name="spnDefaultPort"><property name="minimum"><number>1</number></property><property name="maximum"><number>65535</number></property><property name="value"><number>5000</number></property></widget></item>
      <item row="1" column="2" colspan="2"><widget class="QCheckBox" name="chkAutoLength"><property name="text"><string>Auto payload length from field extents</string></property><property name="checked"><bool>true</bool></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="lBtns">
     <item><widget class="QPushButton" name="btnBuild"><property name="text"><string>Build / Preview</string></property></widget></item>
     <item><spacer name="btnsSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
     <item><widget class="QPushButton" name="btnLoadP"><property name="text"><string>Load Mapping...</string></property></widget></item>
     <item><widget class="QPushButton" name="btnSaveP"><property name="text"><string>Save Mapping...</string></property></widget></item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="gRev">
     <property name="title"><string>4. Review &amp; select (tick what to import; double-click a message row to edit its port / length / header)</string></property>
     <layout class="QVBoxLayout" name="lRev">
      <property name="spacing"><number>4</number></property>
      <item>
       <layout class="QHBoxLayout" name="lCheck">
        <item><widget class="QPushButton" name="btnAll"><property name="text"><string>Check All</string></property></widget></item>
        <item><widget class="QPushButton" name="btnNone"><property name="text"><string>Uncheck All</string></property></widget></item>
        <item><spacer name="checkSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
       </layout>
      </item>
      <item>
       <widget class="QTreeWidget" name="tree">
        <property name="minimumSize"><size><width>0</width><height>120</height></size></property>
        <column><property name="text"><string notr="true">1</string></property></column>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="lblWarnings"><property name="text"><string>Warnings:</string></property></widget>
   </item>
   <item>
    <widget class="QPlainTextEdit" name="txtWarnings">
     <property name="maximumSize"><size><width>16777215</width><height>70</height></size></property>
     <property name="readOnly"><bool>true</bool></property>
     <property name="placeholderText"><string>Parser warnings will appear here after Build / Preview.</string></property>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set></property></widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
