  <layout class="QVBoxLayout" name="mainLayout">
   <item><widget class="QLabel" name="lblInfo"><property name="text"><string>Configure fields for UDP Payload Length (bytes)</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
