        <item><widget class="QPushButton" name="btnImportCsv"><property name="toolTip"><string>Import field definitions from a CSV file. Bitfield and Conditional decoders stay manual.</string></property><property name="text"><string>Import CSV...</string></property></widget></item>
        <item><widget class="QPushButton" name="btnExportCsv"><property name="toolTip"><string>Export the current field definitions to a CSV file (does not include decoders).</string></property><property name="text"><string>Export CSV...</string></property></widget></item>
