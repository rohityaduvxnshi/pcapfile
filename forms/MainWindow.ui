         <item><widget class="QSpinBox" name="spinFilterCount"><property name="minimum"><number>1</number></property><property name="maximum"><number>20</number></property><property name="value"><number>1</number></property></widget></item>
         <item><widget class="QRadioButton" name="radPortFilter"><property name="text"><string>Port</string></property><property name="checked"><bool>true</bool></property></widget></item>
