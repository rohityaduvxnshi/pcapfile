<ui version="4.0">
 <class>SimulatorWindow</class>
 <widget class="QMainWindow" name="SimulatorWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1160</width><height>860</height></rect></property>
  <property name="windowTitle"><string>Universal Data Simulator</string></property>
  <widget class="QWidget" name="centralWidget">
