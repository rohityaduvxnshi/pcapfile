       <item><spacer name="connBarStretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
       <item><widget class="QPushButton" name="btnConfigureConnection"><property name="text"><string>Configure…</string></property><property name="toolTip"><string>Open the connection settings pop-out to choose UDP / TCP / Serial and connect or disconnect.</string></property></widget></item>
      </layout>
     </widget>
    </item>
    <item>
     <widget class="QGroupBox" name="grpMessages">
      <property name="title"><string>Messages</string></property>
      <layout class="QVBoxLayout" name="messagesLayout">
       <item><widget class="QTableWidget" name="tblMessages"><property name="minimumSize"><size><width>0</width><height>200</height></size></property><property name="toolTip"><string>The messages this simulator can send. Tick the Send? box of every message you want streamed; Configure Fields edits the message's fields and values.</string></property></widget></item>
       <item>
        <layout class="QHBoxLayout" name="messageButtonsLayout">
         <item><widget class="QPushButton" name="btnAddMessage"><property name="text"><string>Add Message</string></property><property name="toolTip"><string>Define a new message: name, payload length, data format (HEX or NMEA) and send rate.</string></property></widget></item>
         <item><widget class="QPushButton" name="btnEditMessage"><property name="text"><string>Edit</string></property><property name="toolTip"><string>Edit the selected message's definition.</string></property></widget></item>
         <item><widget class="QPushButton" name="btnRemoveMessage"><property name="text"><string>Remove</string></property><property name="toolTip"><string>Delete the selected message.</string></property></widget></item>
         <item><widget class="QPushButton" name="btnImportIcd"><property name="text"><string>Import ICD…</string></property><property name="toolTip"><string>Import messages and their fields from a Word .docx ICD.</string></property></widget></item>
         <item><spacer name="messageButtonsStretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
         <item><widget class="QPushButton" name="btnStartSending"><property name="minimumSize"><size><width>120</width><height>0</height></size></property><property name="text"><string>Send</string></property><property name="toolTip"><string>Verify everything and stream every ticked message at its own rate until Stop (F5).</string></property></widget></item>
         <item><widget class="QPushButton" name="btnStopSending"><property name="text"><string>Stop</string></property><property name="enabled"><bool>false</bool></property><property name="toolTip"><string>Stop streaming. The link stays connected (Shift+F5).</string></property></widget></item>
         <item><widget class="QLabel" name="lblSendStats"><property name="text"><string>Idle</string></property></widget></item>
        </layout>
       </item>
      </layout>
