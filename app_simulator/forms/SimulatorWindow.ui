<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SimulatorWindow</class>
 <widget class="QMainWindow" name="SimulatorWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1160</width><height>860</height></rect></property>
  <property name="windowTitle"><string>Universal Data Simulator</string></property>
  <widget class="QWidget" name="centralWidget">
   <layout class="QVBoxLayout" name="mainLayout" stretch="0,0,1,0,0">
    <property name="spacing"><number>12</number></property>
    <property name="leftMargin"><number>14</number></property>
    <property name="topMargin"><number>12</number></property>
    <property name="rightMargin"><number>14</number></property>
    <property name="bottomMargin"><number>12</number></property>
    <item>
     <layout class="QHBoxLayout" name="topRowLayout">
      <item><widget class="QLabel" name="lblAppTitle"><property name="text"><string>Universal Data Simulator</string></property></widget></item>
      <item><spacer name="topStretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
      <item><widget class="QPushButton" name="btnTheme"><property name="text"><string>Dark Theme</string></property><property name="toolTip"><string>Switch between Dark and Light themes. The choice is remembered across launches. Shortcut: Ctrl+T</string></property></widget></item>
     </layout>
    </item>
    <item>
     <widget class="QGroupBox" name="grpDestination">
      <property name="title"><string>Destination</string></property>
      <layout class="QVBoxLayout" name="destinationLayout">
       <item>
        <layout class="QHBoxLayout" name="destTypeLayout">
         <item><widget class="QLabel" name="lblDestType"><property name="text"><string>Send via</string></property></widget></item>
         <item><widget class="QComboBox" name="cmbDestinationType">
          <property name="toolTip"><string>Where the simulated data is sent: a UDP destination (IP address + port) or a serial COM port.</string></property>
          <item><property name="text"><string>Ethernet (UDP)</string></property></item>
          <item><property name="text"><string>Serial Port</string></property></item>
         </widget></item>
         <item><spacer name="destTypeStretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
        </layout>
       </item>
       <item>
        <widget class="QStackedWidget" name="stackDestination">
         <widget class="QWidget" name="pageUdp">
          <layout class="QGridLayout" name="udpPageLayout">
           <item row="0" column="0"><widget class="QLabel" name="lblUdpIp"><property name="text"><string>Destination IP</string></property></widget></item>
           <item row="0" column="1"><widget class="QLineEdit" name="txtUdpIp"><property name="placeholderText"><string>e.g. 192.168.1.50 or 239.1.5.6</string></property><property name="toolTip"><string>IPv4 address of the receiver (a multicast group like 239.x.x.x also works).</string></property></widget></item>
           <item row="0" column="2"><widget class="QLabel" name="lblUdpPort"><property name="text"><string>UDP Port</string></property></widget></item>
           <item row="0" column="3"><widget class="QSpinBox" name="spinUdpPort"><property name="minimum"><number>1</number></property><property name="maximum"><number>65535</number></property><property name="value"><number>5000</number></property><property name="toolTip"><string>UDP port the receiver listens on.</string></property></widget></item>
           <item row="0" column="4"><spacer name="udpStretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          </layout>
         </widget>
         <widget class="QWidget" name="pageSerial">
          <layout class="QGridLayout" name="serialPageLayout">
           <item row="0" column="0"><widget class="QLabel" name="lblSerialPort"><property name="text"><string>Port</string></property></widget></item>
           <item row="0" column="1"><widget class="QComboBox" name="cmbSerialPort"><property name="editable"><bool>true</bool></property><property name="toolTip"><string>Serial COM port to send on. Press Refresh to re-scan the ports available on this PC.</string></property></widget></item>
           <item row="0" column="2"><widget class="QPushButton" name="btnRefreshSerialPorts"><property name="text"><string>Refresh</string></property><property name="toolTip"><string>Re-scan the serial ports available on this PC.</string></property></widget></item>
           <item row="0" column="3"><widget class="QLabel" name="lblSerialBaud"><property name="text"><string>Baud rate</string></property></widget></item>
           <item row="0" column="4"><widget class="QComboBox" name="cmbSerialBaud">
            <property name="editable"><bool>true</bool></property>
            <property name="toolTip"><string>Bits per second. Pick a preset or type any rate the device supports.</string></property>
            <item><property name="text"><string>115200</string></property></item>
            <item><property name="text"><string>9600</string></property></item>
            <item><property name="text"><string>4800</string></property></item>
            <item><property name="text"><string>19200</string></property></item>
            <item><property name="text"><string>38400</string></property></item>
            <item><property name="text"><string>57600</string></property></item>
            <item><property name="text"><string>230400</string></property></item>
            <item><property name="text"><string>460800</string></property></item>
            <item><property name="text"><string>921600</string></property></item>
           </widget></item>
           <item row="0" column="5"><spacer name="serialStretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
           <item row="1" column="0"><widget class="QLabel" name="lblSerialDataBits"><property name="text"><string>Data bits</string></property></widget></item>
           <item row="1" column="1"><widget class="QComboBox" name="cmbSerialDataBits">
            <property name="toolTip"><string>Number of data bits per character (8 is by far the most common).</string></property>
            <item><property name="text"><string>8</string></property></item>
            <item><property name="text"><string>7</string></property></item>
            <item><property name="text"><string>6</string></property></item>
            <item><property name="text"><string>5</string></property></item>
           </widget></item>
           <item row="1" column="2"><widget class="QLabel" name="lblSerialParity"><property name="text"><string>Parity</string></property></widget></item>
           <item row="1" column="3"><widget class="QComboBox" name="cmbSerialParity">
            <property name="toolTip"><string>Parity bit scheme (None is by far the most common).</string></property>
            <item><property name="text"><string>None</string></property></item>
            <item><property name="text"><string>Even</string></property></item>
            <item><property name="text"><string>Odd</string></property></item>
            <item><property name="text"><string>Mark</string></property></item>
            <item><property name="text"><string>Space</string></property></item>
           </widget></item>
           <item row="1" column="4"><widget class="QLabel" name="lblSerialStopBits"><property name="text"><string>Stop bits</string></property></widget></item>
           <item row="1" column="5"><widget class="QComboBox" name="cmbSerialStopBits">
            <property name="toolTip"><string>Number of stop bits (1 is by far the most common; 1.5 is only valid with 5 data bits on most hardware).</string></property>
            <item><property name="text"><string>1</string></property></item>
            <item><property name="text"><string>1.5</string></property></item>
            <item><property name="text"><string>2</string></property></item>
           </widget></item>
          </layout>
         </widget>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="connectLayout">
         <item><widget class="QPushButton" name="btnConnect"><property name="text"><string>Connect</string></property><property name="toolTip"><string>Open the link and send a short health-check message. Green dot = the health message was transmitted; red dot = the link could not be opened or the send failed (a warning explains why). For UDP, green means the datagram was handed to the network — UDP cannot confirm a receiver is listening.</string></property></widget></item>
         <item><widget class="QPushButton" name="btnDisconnect"><property name="text"><string>Disconnect</string></property><property name="enabled"><bool>false</bool></property><property name="toolTip"><string>Close the link.</string></property></widget></item>
         <item><widget class="QLabel" name="lblLinkDot"><property name="text"><string>●</string></property></widget></item>
         <item><widget class="QLabel" name="lblLinkStatus"><property name="text"><string>Not connected</string></property></widget></item>
         <item><spacer name="connectStretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
        </layout>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <widget class="QGroupBox" name="grpMessages">
      <property name="title"><string>Messages</string></property>
      <layout class="QVBoxLayout" name="messagesLayout">
       <item><widget class="QTableWidget" name="tblMessages"><property name="minimumSize"><size><width>0</width><height>220</height></size></property><property name="toolTip"><string>The messages this simulator can send. Tick the Send? box of every message you want streamed; Configure Fields edits the message's fields and the values to transmit.</string></property></widget></item>
       <item>
        <layout class="QHBoxLayout" name="messageButtonsLayout">
         <item><widget class="QPushButton" name="btnAddMessage"><property name="text"><string>Add Message</string></property><property name="toolTip"><string>Define a new message: name, payload length, data format (HEX or NMEA) and send rate.</string></property></widget></item>
         <item><widget class="QPushButton" name="btnEditMessage"><property name="text"><string>Edit</string></property><property name="toolTip"><string>Edit the selected message's definition.</string></property></widget></item>
         <item><widget class="QPushButton" name="btnRemoveMessage"><property name="text"><string>Remove</string></property><property name="toolTip"><string>Delete the selected message.</string></property></widget></item>
         <item><spacer name="messageButtonsStretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
         <item><widget class="QPushButton" name="btnImportIcd"><property name="text"><string>Import ICD…</string></property><property name="toolTip"><string>Import messages and their fields from a Word .docx ICD. You pick which tables hold field definitions; each becomes a message added below.</string></property></widget></item>
        </layout>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <widget class="QGroupBox" name="grpSending">
      <property name="title"><string>Send</string></property>
      <layout class="QHBoxLayout" name="sendingLayout">
       <item><widget class="QPushButton" name="btnStartSending"><property name="minimumSize"><size><width>130</width><height>0</height></size></property><property name="text"><string>Send</string></property><property name="toolTip"><string>Verify everything (connection, ticked messages, every field value) and then stream each ticked message at its own rate until Stop. Shortcut: F5</string></property></widget></item>
       <item><widget class="QPushButton" name="btnStopSending"><property name="text"><string>Stop</string></property><property name="enabled"><bool>false</bool></property><property name="toolTip"><string>Stop streaming. The link stays connected. Shortcut: Shift+F5</string></property></widget></item>
       <item><widget class="QLabel" name="lblSendStats"><property name="text"><string>Idle</string></property></widget></item>
       <item><spacer name="sendingStretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
      </layout>
     </widget>
    </item>
    <item>
     <widget class="QGroupBox" name="grpPreview">
      <property name="title"><string>Outgoing Data Preview (hex — last 5 sends)</string></property>
      <layout class="QVBoxLayout" name="previewLayout">
       <item><widget class="QPlainTextEdit" name="txtHexPreview"><property name="readOnly"><bool>true</bool></property><property name="maximumBlockCount"><number>5</number></property><property name="minimumSize"><size><width>0</width><height>90</height></size></property><property name="maximumSize"><size><width>16777215</width><height>140</height></size></property><property name="toolTip"><string>The exact bytes most recently handed to the link, newest at the bottom (rolling 5 lines).</string></property></widget></item>
      </layout>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QMenuBar" name="menuBar">
   <property name="geometry"><rect><x>0</x><y>0</y><width>1160</width><height>26</height></rect></property>
   <widget class="QMenu" name="menuFile">
    <property name="title"><string>File</string></property>
    <addaction name="actOpenSetup"/>
    <addaction name="actSaveSetup"/>
    <addaction name="actSaveSetupAs"/>
    <addaction name="separator"/>
    <addaction name="actImportIcd"/>
    <addaction name="separator"/>
    <addaction name="actQuit"/>
   </widget>
   <widget class="QMenu" name="menuHelp">
    <property name="title"><string>Help</string></property>
    <addaction name="actUserManual"/>
    <addaction name="actShortcuts"/>
   </widget>
   <addaction name="menuFile"/>
   <addaction name="menuHelp"/>
  </widget>
  <widget class="QStatusBar" name="statusBar"/>
  <action name="actOpenSetup"><property name="text"><string>Open Setup...</string></property><property name="shortcut"><string>Ctrl+O</string></property><property name="toolTip"><string>Load a saved simulator setup (destination + messages + values) from a JSON file.</string></property></action>
  <action name="actSaveSetup"><property name="text"><string>Save Setup</string></property><property name="shortcut"><string>Ctrl+S</string></property><property name="toolTip"><string>Save the whole simulator setup (destination + messages + values) to a JSON file.</string></property></action>
  <action name="actSaveSetupAs"><property name="text"><string>Save Setup As...</string></property><property name="shortcut"><string>Ctrl+Shift+S</string></property></action>
  <action name="actImportIcd"><property name="text"><string>Import ICD (.docx)...</string></property><property name="shortcut"><string>Ctrl+I</string></property><property name="toolTip"><string>Import messages and fields from a Word .docx ICD.</string></property></action>
  <action name="actQuit"><property name="text"><string>Quit</string></property><property name="shortcut"><string>Ctrl+Q</string></property></action>
  <action name="actShortcuts"><property name="text"><string>Keyboard Shortcuts</string></property><property name="shortcut"><string>Shift+F1</string></property></action>
  <action name="actUserManual"><property name="text"><string>User Manual...</string></property><property name="shortcut"><string>F1</string></property><property name="toolTip"><string>Open the searchable user manual (common functions + troubleshooting).</string></property></action>
 </widget>
