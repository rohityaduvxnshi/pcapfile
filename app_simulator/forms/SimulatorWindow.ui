    <item>
     <widget class="QGroupBox" name="grpHistory">
      <property name="title"><string>Outgoing Data History</string></property>
      <layout class="QVBoxLayout" name="historyLayout">
       <item>
        <layout class="QHBoxLayout" name="historyControlsLayout">
         <item><widget class="QPushButton" name="btnClearHistory"><property name="text"><string>Clear</string></property><property name="toolTip"><string>Empty the history table.</string></property></widget></item>
         <item><widget class="QCheckBox" name="chkAutoScroll"><property name="text"><string>Auto-scroll</string></property><property name="checked"><bool>true</bool></property><property name="toolTip"><string>Keep the newest row in view as data is sent.</string></property></widget></item>
         <item><widget class="QLabel" name="lblHistMax"><property name="text"><string>Max rows</string></property></widget></item>
         <item><widget class="QSpinBox" name="spinHistoryMax"><property name="minimum"><number>100</number></property><property name="maximum"><number>1000000</number></property><property name="value"><number>2000</number></property><property name="toolTip"><string>Older rows are dropped once the history exceeds this many rows.</string></property></widget></item>
         <item><spacer name="historyControlsStretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
         <item><widget class="QLabel" name="lblHistoryCount"><property name="text"><string>0 frames</string></property></widget></item>
        </layout>
       </item>
       <item><widget class="QTableWidget" name="tblHistory"><property name="minimumSize"><size><width>0</width><height>160</height></size></property><property name="alternatingRowColors"><bool>true</bool></property><property name="toolTip"><string>Every payload handed to the link, newest at the bottom: time, message, byte count and hex.</string></property></widget></item>
