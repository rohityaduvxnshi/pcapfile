       <item><widget class="QLabel" name="lblLinkDot"><property name="text"><string>●</string></property></widget></item>
       <item><widget class="QLabel" name="lblConnName"><property name="text"><string>Not connected</string></property><property name="toolTip"><string>The active connection (destination + status). Press Configure to change it.</string></property></widget></item>
