        <item><widget class="QToolButton" name="btnExcelMenu"><property name="toolTip"><string>Excel (.xlsx) operations: Import, Export. Same columns as CSV; bit decoders are not carried in the spreadsheet (use JSON for those).</string></property><property name="text"><string>Excel ▾</string></property><property name="popupMode"><enum>QToolButton::InstantPopup</enum></property><property name="minimumSize"><size><width>80</width><height>0</height></size></property></widget></item>
