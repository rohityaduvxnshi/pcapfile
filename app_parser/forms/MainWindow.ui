    <item>
     <widget class="QGroupBox" name="liveGroup">
      <property name="title"><string>Live Capture (UDP / TCP)</string></property>
      <layout class="QVBoxLayout" name="liveMainLayout">
       <item>
        <layout class="QHBoxLayout" name="liveConnectionsLayout">
         <item><widget class="QPushButton" name="btnConfigureConnections"><property name="text"><string>Configure Connections…</string></property><property name="toolTip"><string>Define multiple live-capture connections (adapter + port). Each message is decoded only from the connection it is bound to. When no connections are defined, the single Transport/Port row below is used.</string></property></widget></item>
         <item><widget class="QLabel" name="lblLiveConnSummary"><property name="text"><string>No connections defined — using single Transport/Port below</string></property></widget></item>
         <item><spacer name="liveConnectionsStretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="liveControlLayout">
         <item><widget class="QPushButton" name="btnManageLiveLengthFilters"><property name="toolTip"><string>Define the per-message decoding rules for live mode (length, optional header, fields, compare options, and the connection each message is bound to). Connection transport / adapter / port are set in Configure Connections…</string></property><property name="text"><string>Configure Messages</string></property></widget></item>
         <item><widget class="QLabel" name="lblLiveLengthFilterStatus"><property name="text"><string>No length filters</string></property></widget></item>
         <item><widget class="QPushButton" name="btnStartLive"><property name="text"><string>Start Live Capture</string></property></widget></item>
