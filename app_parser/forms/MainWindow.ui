       <item row="0" column="0"><widget class="QLabel" name="lblFile"><property name="text"><string>Capture File</string></property></widget></item>
       <item row="0" column="1"><widget class="QLineEdit" name="txtFilePath"><property name="placeholderText"><string>Select .pcap or .pcapng file</string></property></widget></item>
       <item row="0" column="2"><widget class="QPushButton" name="btnBrowse"><property name="text"><string>Browse</string></property><property name="toolTip"><string>Pick a .pcap / .pcapng capture file (Ctrl+B). If a saved project exists for it you will be offered a restore.</string></property></widget></item>
       <item row="0" column="3"><widget class="QPushButton" name="btnStart"><property name="minimumSize"><size><width>130</width><height>0</height></size></property><property name="text"><string>Start Export</string></property><property name="toolTip"><string>Run the extraction over the capture file and write the Excel output (F5).</string></property></widget></item>
      </layout>
