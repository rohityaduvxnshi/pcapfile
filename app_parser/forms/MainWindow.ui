   <property name="text"><string>Import Messages (JSON)...</string></property>
   <property name="toolTip"><string>Import message definitions (fields, bits, compare options) from a shareable JSON file — the same format the simulator uses. Messages are added to the current mode's length filters.</string></property>
  </action>
  <action name="actExportMessagesJson">
