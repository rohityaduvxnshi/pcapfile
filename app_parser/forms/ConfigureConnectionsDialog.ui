        </item>
        <item row="4" column="1">
         <widget class="QComboBox" name="cmbTcpRole">
          <item>
           <property name="text">
            <string>Listen (server)</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Connect (client)</string>
           </property>
          </item>
