        </item>
        <item row="6" column="0" colspan="2">
         <widget class="QLabel" name="lblHint">
          <property name="text">
           <string>For UDP you only choose an adapter and port — no IP address is typed.</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
