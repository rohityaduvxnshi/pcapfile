        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="lblAdapter">
          <property name="text">
           <string>Adapter</string>
          </property>
         </widget>
        </item>
        <item row="2" column="1">
         <layout class="QHBoxLayout" name="adapterLayout">
          <item>
           <widget class="QComboBox" name="cmbAdapter"/>
          </item>
          <item>
           <widget class="QPushButton" name="btnRefreshAdapters">
            <property name="text">
             <string>Refresh</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item row="3" column="0">
         <widget class="QLabel" name="lblPort">
          <property name="text">
           <string>Port</string>
          </property>
         </widget>
        </item>
        <item row="3" column="1">
         <widget class="QSpinBox" name="spinPort">
          <property name="minimum">
           <number>1</number>
          </property>
          <property name="maximum">
           <number>65535</number>
          </property>
          <property name="value">
           <number>5000</number>
          </property>
         </widget>
        </item>
        <item row="4" column="0">
         <widget class="QLabel" name="lblTcpRole">
          <property name="text">
           <string>TCP role</string>
          </property>
