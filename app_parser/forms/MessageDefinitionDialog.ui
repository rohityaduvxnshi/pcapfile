 <class>MessageDefinitionDialog</class>
 <widget class="QDialog" name="MessageDefinitionDialog">
  <property name="geometry"><rect><x>0</x><y>0</y><width>520</width><height>200</height></rect></property>
  <property name="windowTitle"><string>Message Definition</string></property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QGroupBox" name="definitionGroup">
     <property name="title"><string>Message Definition</string></property>
     <layout class="QFormLayout" name="formLayout">
      <item row="0" column="0"><widget class="QLabel" name="lblMessageName"><property name="text"><string>Message Name</string></property></widget></item>
      <item row="0" column="1"><widget class="QLineEdit" name="txtMessageName"><property name="placeholderText"><string>Example: Msg_A</string></property></widget></item>
      <item row="1" column="0"><widget class="QLabel" name="lblPort"><property name="text"><string>UDP Port</string></property></widget></item>
      <item row="1" column="1"><widget class="QSpinBox" name="spinPort"><property name="minimum"><number>1</number></property><property name="maximum"><number>65535</number></property><property name="value"><number>5000</number></property><property name="toolTip"><string>UDP port this message is carried on. Packets are routed to this message by Port + Payload Length (+ optional Header).</string></property></widget></item>
      <item row="2" column="0"><widget class="QLabel" name="lblPayloadLength"><property name="text"><string>Payload Length (bytes)</string></property></widget></item>
      <item row="2" column="1"><widget class="QSpinBox" name="spinPayloadLength"><property name="minimum"><number>1</number></property><property name="maximum"><number>1000000</number></property><property name="value"><number>1</number></property></widget></item>
      <item row="3" column="0"><widget class="QLabel" name="lblOptionalHeader"><property name="text"><string>Optional Header (hex)</string></property></widget></item>
      <item row="3" column="1"><widget class="QLineEdit" name="txtOptionalHeader"><property name="placeholderText"><string>Optional. 0 to 8 hex chars to disambiguate same-length msgs, e.g. A1B2</string></property><property name="toolTip"><string>OPTIONAL. Leave blank if not needed. When two or more messages on the same port share the same payload length, fill in the leading bytes of this message in hex (no 0x prefix, no spaces) so packets can be told apart. Up to 8 hex characters (4 bytes).</string></property><property name="maxLength"><number>32</number></property></widget></item>
      <item row="4" column="0"><widget class="QLabel" name="lblDataFormat"><property name="text"><string>Data Format</string></property></widget></item>
      <item row="4" column="1"><widget class="QComboBox" name="cmbDataFormat"><property name="toolTip"><string>HEX: byte-offset extraction (default). NMEA: decode ASCII NMEA 0183 sentences; matched by sentence formatter rather than exact length.</string></property><item><property name="text"><string>HEX</string></property></item><item><property name="text"><string>NMEA</string></property></item></widget></item>
      <item row="5" column="0"><widget class="QLabel" name="lblNmeaSentenceCaption"><property name="text"><string>NMEA Sentence</string></property></widget></item>
      <item row="5" column="1"><widget class="QLabel" name="lblNmeaSentence"><property name="text"><string>-</string></property></widget></item>
